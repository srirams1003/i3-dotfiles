*.db

# tmux-resurrect-backup/ is NOT versioned at all any more.
#
# Saved layouts embed pane titles, which on a work machine are project and
# client names. That is the same class of content as shell history: it cannot be
# redacted meaningfully, and this repo is meant to be public. The layouts still
# live in ~/.local/share/tmux/resurrect (resurrect keeps its own 5-copy window);
# they are simply not something git should carry.
tmux-resurrect-backup/

# Shell history is likewise gone — see backup_stuff.sh. Use atuin for
# cross-machine history (end-to-end encrypted), not a git repo.
my_zsh_history
