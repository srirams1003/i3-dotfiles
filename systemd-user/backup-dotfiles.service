[Unit]
Description=Back up tmux session state and zsh history into ~/.config/i3
Documentation=file://%h/.config/i3/README.md

[Service]
Type=oneshot
ExecStart=/bin/bash %h/.config/i3/backup_stuff.sh
# Never let a backup stall the session or fight for disk with real work.
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
